SWITCHYARD_POSTGRES_DB=switchyard
SWITCHYARD_POSTGRES_USER=switchyard
SWITCHYARD_POSTGRES_PASSWORD=switchyard-local-only
SWITCHYARD_POSTGRES_PORT=5432
SWITCHYARD_ORDERING_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_INVENTORY_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_PAYMENTS_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_FULFILMENT_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_RETURNS_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_RETURNS_OUTBOX_BATCH_SIZE=50
SWITCHYARD_RETURNS_OUTBOX_LEASE_SECONDS=60
SWITCHYARD_RETURNS_OUTBOX_RETRY_SECONDS=30
SWITCHYARD_RETURNS_OUTBOX_POLL_MILLISECONDS=500

# Deterministic local Payments provider and reconciliation behaviour.
# Supported authorisation values: Authorise, Decline, Indeterminate.
# Supported reconciliation values: Authorise, Decline, StillIndeterminate.
# Supported settlement values: Succeed, Indeterminate.
# Supported settlement reconciliation values: Succeed, NotApplied, StillIndeterminate.
SWITCHYARD_PAYMENT_AUTHORISATION_SCENARIO=Authorise
SWITCHYARD_PAYMENT_RECONCILIATION_SCENARIO=Authorise
SWITCHYARD_PAYMENT_SETTLEMENT_SCENARIO=Succeed
SWITCHYARD_PAYMENT_SETTLEMENT_RECONCILIATION_SCENARIO=Succeed
SWITCHYARD_PAYMENTS_RECONCILIATION_BATCH_SIZE=25
SWITCHYARD_PAYMENTS_RECONCILIATION_MAX_ATTEMPTS=5
SWITCHYARD_PAYMENTS_RECONCILIATION_RETRY_SECONDS=30
SWITCHYARD_PAYMENTS_RECONCILIATION_POLL_MILLISECONDS=1000
SWITCHYARD_PAYMENTS_SETTLEMENT_RECONCILIATION_BATCH_SIZE=25
SWITCHYARD_PAYMENTS_SETTLEMENT_RECONCILIATION_MAX_ATTEMPTS=5
SWITCHYARD_PAYMENTS_SETTLEMENT_RECONCILIATION_RETRY_SECONDS=30
SWITCHYARD_PAYMENTS_SETTLEMENT_RECONCILIATION_POLL_MILLISECONDS=1000

# Azure Service Bus emulator. Review the Microsoft emulator and SQL Server EULAs
# before changing SWITCHYARD_SERVICEBUS_ACCEPT_EULA to Y.
SWITCHYARD_SERVICEBUS_ACCEPT_EULA=N
SWITCHYARD_SERVICEBUS_SQL_PASSWORD=replace-with-a-strong-local-only-password
SWITCHYARD_SERVICEBUS_PORT=5672
SWITCHYARD_SERVICEBUS_HTTP_PORT=5300
SWITCHYARD_SERVICEBUS_TOPIC=switchyard-events
SWITCHYARD_SERVICEBUS_SUBSCRIPTION=ordering
SWITCHYARD_INVENTORY_SERVICEBUS_SUBSCRIPTION=inventory
SWITCHYARD_INVENTORY_RELEASE_SERVICEBUS_SUBSCRIPTION=inventory-release
SWITCHYARD_PAYMENTS_SERVICEBUS_SUBSCRIPTION=payments
SWITCHYARD_FULFILMENT_SERVICEBUS_SUBSCRIPTION=fulfilment
SWITCHYARD_RETURNS_SERVICEBUS_SUBSCRIPTION=returns
SWITCHYARD_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
