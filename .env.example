SWITCHYARD_POSTGRES_DB=switchyard
SWITCHYARD_POSTGRES_USER=switchyard
SWITCHYARD_POSTGRES_PASSWORD=switchyard-local-only
SWITCHYARD_POSTGRES_PORT=5432
SWITCHYARD_ORDERING_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_INVENTORY_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only
SWITCHYARD_PAYMENTS_CONNECTION_STRING=Host=localhost;Port=5432;Database=switchyard;Username=switchyard;Password=switchyard-local-only

# Azure Service Bus emulator. Review the Microsoft emulator and SQL Server EULAs
# before changing SWITCHYARD_SERVICEBUS_ACCEPT_EULA to Y.
SWITCHYARD_SERVICEBUS_ACCEPT_EULA=N
SWITCHYARD_SERVICEBUS_SQL_PASSWORD=replace-with-a-strong-local-only-password
SWITCHYARD_SERVICEBUS_PORT=5672
SWITCHYARD_SERVICEBUS_HTTP_PORT=5300
SWITCHYARD_SERVICEBUS_TOPIC=switchyard-events
SWITCHYARD_SERVICEBUS_SUBSCRIPTION=ordering
SWITCHYARD_INVENTORY_SERVICEBUS_SUBSCRIPTION=inventory
SWITCHYARD_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
