root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{js,mjs,ts,tsx,json,yml,yaml,css,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = true
# EF Core owns migration and model-snapshot code generation.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1861.severity = none
